{
  "name": "backend",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "check": "bun run format:check && bun run lint",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:sign": "prisma db sign",
    "db:migration": "prisma migration plan --name",
    "db:migrate": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "7",
    "@wesleytodd/openapi": "^1.1.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "morgan": "^1.12.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "prisma": "^7.10.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
